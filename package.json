  "engines": {
    "node": ">=24.14.0 <25"
  },
  "dependencies": {
    "@material-design-icons/svg": "^0.14.15",
    "base64-arraybuffer": "^1.0.2",
    "bootstrap": "^5.3.8",
    "buffer": "^6.0.3",
